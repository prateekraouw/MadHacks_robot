<?xml version="1.0"?>
<robot name="simple_4dof_arm">

  <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="blue"><color rgba="0 0 0.8 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><cylinder length="0.05" radius="0.05"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/> <geometry><box size="0.03 0.03 0.1"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/> <axis xyz="0 1 0"/> <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <link name="elbow_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.1"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.06"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  
  <joint name="joint_4" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

</robot>